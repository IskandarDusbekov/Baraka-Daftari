# --- Django ---
# Production: python -c "import secrets; print(secrets.token_urlsafe(50))" bilan yarating
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Production misol: CSRF_TRUSTED_ORIGINS=https://baraka.uz,https://www.baraka.uz
CSRF_TRUSTED_ORIGINS=

# Production: HTTPS ulangach yoqing
SSL_REDIRECT=False
HSTS_SECONDS=0

# Django admin manzili. Productionda taxmin qilib bo'lmaydigan yo'l qo'ying, masalan: baza-7f3k9q/
ADMIN_URL=admin/

# Kesh va rate limit uchun (production'da shart): redis://127.0.0.1:6379/1
REDIS_URL=

# --- Ma'lumotlar bazasi ---
# Bo'sh qoldirilsa, lokal ishlash uchun SQLite ishlatiladi.
# Production uchun: DB_ENGINE=postgres
DB_ENGINE=
POSTGRES_DB=baraka
POSTGRES_USER=baraka
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Telegram ---
# @BotFather dan olingan token va bot username (@ belgisisiz)
BOT_TOKEN=
BOT_USERNAME=
# Mini App manzili (HTTPS bo'lishi shart), masalan: https://baraka.uz/
WEBAPP_URL=

# Har kungi zaxira nusxa shu Telegram ID(lar)ga yuboriladi (vergul bilan). Avval botga /start yozing.
BACKUP_CHAT_IDS=

# --- Dasturchi kirishi (login/parol) ---
# Productionda DEV_LOGIN=False qiling! Foydalanuvchini yaratish: python manage.py create_dev_user
DEV_LOGIN=True
DEV_USERNAME=admin
DEV_PASSWORD=

# --- Eslatmalar (Toshkent vaqti bo'yicha soat) ---
MORNING_HOUR=8
EVENING_HOUR=20
