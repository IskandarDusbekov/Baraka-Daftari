# /etc/systemd/system/baraka-bot.service
# Bot + ertalabki/kechki eslatmalar (MORNING_HOUR / EVENING_HOUR, Toshkent vaqti)
[Unit]
Description=Baraka Daftari - Telegram bot
After=network.target postgresql.service redis-server.service

[Service]
User=baraka
WorkingDirectory=/srv/baraka
ExecStart=/srv/baraka/.venv/bin/python manage.py runbot
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
